# Образец. Скопировать в .dev.vars и вписать настоящие значения.
# Файл .dev.vars в git не попадает — он в .gitignore.
#
# На боевом стенде эти же значения задаются командой:
#   wrangler secret put TG_TOKEN

TG_TOKEN="токен от BotFather"
TG_SECRET="произвольная длинная строка для пути вебхука"
HOOK_SECRET="произвольная длинная строка для вебхука YouGile"
BOOTSTRAP_SECRET="одноразовый секрет для создания первого пользователя"
