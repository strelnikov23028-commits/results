# Скопируй в .env и заполни. Файл .env в git не попадает.

WORKER_NAME=neoved-chat
CF_ACCOUNT=
CF_SUBDOMAIN=

# Заполняется автоматически при первом запуске deploy.mjs.
KV_ID=

# --- amoCRM ---
AMO_SUBDOMAIN=neoved

# Долгосрочный токен интеграции: Настройки → Интеграции → «+ Создать интеграцию»
# → Внешняя интеграция → «Ключи и доступы» → «Долгосрочный токен».
AMO_TOKEN=

# Произвольная строка: часть URL вебхука amoCRM и адреса /debug.
HOOK_SECRET=

# Серверный ключ Яндекс SmartCaptcha. Пусто — проверка выключена, работают
# только лимиты по IP. Клиентский ключ передаётся виджету через data-captcha.
CAPTCHA_KEY=

# --- воронка ---
# 11212054 — «Чат на сайте», 87966922 — её этап «Первичный контакт».
PIPELINE_ID=11212054
STATUS_ID=87966922

# На этот этап возвращаем сделку, если человек написал повторно. Ищется внутри
# её собственной воронки — между воронками сделка не переезжает.
NEW_STATUS_NAME=Первичный контакт

TAG_NAME=site_chat
# Название сделки: «site chat: Иван | uslugi/ved».
LEAD_NAME_PREFIX=site chat
SITE_HOST=neoved.io

# --- поля ---
# Контакт и компания: стандартные Email и Телефон, пишем с типом «раб.».
EMAIL_FIELD=629257
PHONE_FIELD=629255
# «ИНН» у компании.
COMPANY_INN_FIELD=630037
# «Источник» у сделки — туда кладём полный адрес страницы, с которой написали.
LEAD_URL_FIELD=980989

# --- поведение ---
# Пусто — виджет можно ставить на любой домен. Иначе список origin через запятую,
# например: https://neoved.io,https://www.neoved.io
ALLOW_ORIGINS=

# Пусто — клиенту уходит любое обычное примечание, написанное человеком.
# Если поставить, например, «+», уходить будут только примечания с этого знака.
REPLY_PREFIX=

# Пометки, которыми соседние интеграции начинают исходящие сообщения:
# в чате у клиента они лишние.
STRIP_PREFIXES=Ответ:

# Антиспам: заявок с одного IP в час и сообщений в рамках одной сессии.
START_LIMIT=5
MSG_LIMIT=60

# На что подписываем вебхук в amoCRM (ответы менеджера).
WEBHOOK_EVENTS=note_lead
